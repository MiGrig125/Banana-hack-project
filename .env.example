# Application
APP_NAME=AI Photo Studio
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./ai_photo.db

# Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_COUNT=4

# OpenAI (generation, editing, vision analysis)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: xAI Grok Imagine (if you have XAI_API_KEY)
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image

# Defaults
DEFAULT_IMAGE_PROVIDER=openai
DEFAULT_VISION_PROVIDER=openai

# Task / rate limiting (simple)
TASK_TIMEOUT_SECONDS=180
ENABLE_RATE_LIMIT=false
